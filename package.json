{
  "name": "mineos-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:classic": "next dev",
    "dev:clean": "node -e \"try{require('fs').rmSync('.next',{recursive:true,force:true})}catch(e){}\" && next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "supabase:link": "supabase link --project-ref abhfedunawgzfnzeazgb",
    "supabase:migrate": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/supabase-apply-migration.ps1",
    "supabase:migrate:acarreo": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/supabase-apply-acarreo.ps1",
    "supabase:migrate:acarreo-import": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/supabase-apply-acarreo-import.ps1",
    "supabase:migrate:acarreo-fotos": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/supabase-apply-acarreo-fotos.ps1",
    "supabase:migrate:reportes-storage": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/supabase-apply-reportes-storage.ps1",
    "supabase:migrate:informes-borrador": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/supabase-apply-informes-borrador.ps1",
    "supabase:migrate:gastos-oro": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/supabase-apply-migration.ps1 migration_gastos_pago_oro.sql",
    "supabase:check": "supabase db query --linked \"SELECT EXISTS (SELECT 1 FROM information_schema.tables WHERE table_schema = 'public' AND table_name = 'biblioteca_categorias') AS biblioteca, EXISTS (SELECT 1 FROM information_schema.tables WHERE table_schema = 'public' AND table_name = 'fiscal_entidades') AS fiscal;\"",
    "supabase:migrate:plataforma": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/supabase-apply-plataforma.ps1",
    "supabase:migrate:nomina": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/supabase-apply-nomina.ps1",
    "supabase:migrate:nomina-archive": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/supabase-apply-nomina-archive.ps1",
    "test:nomina": "npx tsx --test src/lib/nomina/nomina-engine.test.ts src/lib/nomina/nomina-preview.test.ts src/lib/nomina/nomina-export-xlsx.test.ts src/lib/nomina/perfil-ciclo-reglas.test.ts src/lib/validations/nomina-cierre.test.ts",
    "test:rotacion-plantillas": "npx tsx --test src/lib/rotacion-plantillas/semana-cierre.test.ts src/lib/rotacion-plantillas/projection.test.ts src/lib/rotacion-plantillas/cierre-integracion.test.ts",
    "supabase:migrate:rotacion": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/supabase-apply-rotacion.ps1",
    "supabase:migrate:reconciliation": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/supabase-apply-reconciliation.ps1",
    "test:reconciliation": "npx tsx --test src/lib/reconciliation/reconciliation-engine.test.ts"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.101.1",
    "@tanstack/react-table": "^8.21.3",
    "@tauri-apps/api": "^2.10.1",
    "@tremor/react": "^3.18.7",
    "@types/pdf-parse": "^1.1.5",
    "animejs": "^4.3.6",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.38.0",
    "headlessui": "^0.0.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^1.7.0",
    "next": "16.2.2",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^4.10.38",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "three": "^0.184.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tauri-apps/cli": "^2.10.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "pg": "^8.21.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^5"
  }
}
